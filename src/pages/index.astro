---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const page = await getEntry('pages', 'startseite');
if (!page) throw new Error('Missing content: startseite');
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description} ogImage={page.data.ogImage} isHome>
  <div class="home prose">
    <Content />
  </div>
</BaseLayout>

<style>
  .home {
    max-width: 52rem;
    margin: 0 auto;
    padding: 2.5rem 1rem 0;
  }
</style>
