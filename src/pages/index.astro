---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { websiteSchema } from '../structured-data';

const page = await getEntry('pages', 'startseite');
if (!page) throw new Error('Missing content: startseite');
const { Content } = await render(page);
---

<BaseLayout
  title={page.data.title}
  seoTitle={page.data.seoTitle}
  description={page.data.description}
  ogImage={page.data.ogImage}
  jsonLd={[websiteSchema(page.data.description)]}
  isHome
>
  <div class="home prose">
    <Content />
  </div>
</BaseLayout>

<style>
  .home {
    max-width: 52rem;
    margin: 0 auto;
    padding: 2.5rem 1rem 0;
  }
</style>
