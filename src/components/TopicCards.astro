---
import { Image } from 'astro:assets';
import geologie from '../assets/images/geologie-fossilien.jpg';
import biogeographie from '../assets/images/biogeographie.jpg';
import biologie from '../assets/images/biologie-genetik.jpg';
import oekologie from '../assets/images/geologie-korallen.png';

const topics = [
  {
    href: '/geologie/',
    title: 'Geologie',
    text: 'Eisbohrkerne, Fossilien, Plattentektonik und Korallenriffe als Archive der Erdgeschichte.',
    img: geologie,
  },
  {
    href: '/biogeographie/',
    title: 'Biogeographie',
    text: 'Warum die Verteilung der Tiere keine Ausbreitung vom Ararat erkennen lässt.',
    img: biogeographie,
  },
  {
    href: '/biologie-genetik/',
    title: 'Biologie & Genetik',
    text: 'Genetischer Flaschenhals, Nahrungsketten und das Parasiten-Problem.',
    img: biologie,
  },
  {
    href: '/oekologie/',
    title: 'Ökologie',
    text: 'Salzgehalt, Schlamm und Licht: Warum eine globale Flut das Leben im Wasser bedroht hätte.',
    img: oekologie,
  },
];
---

<ul class="cards">
  {
    topics.map((t) => (
      <li class="card">
        <Image src={t.img} alt="" widths={[400, 700]} sizes="(max-width: 640px) 100vw, 34rem" />
        <div class="card-body">
          <h3>
            <a href={t.href}>{t.title}</a>
          </h3>
          <p>{t.text}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .cards {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1.2rem;
  }

  .card {
    position: relative;
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 2px);
    overflow: hidden;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .card:hover,
  .card:focus-within {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px -16px rgb(0 0 0 / 0.5);
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }

    .card:hover,
    .card:focus-within {
      transform: none;
    }
  }

  .card :global(img) {
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
  }

  .card-body {
    padding: 0.9rem 1.1rem 0.3rem;
  }

  h3 {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
  }

  h3 a {
    color: var(--text);
    text-decoration: none;
  }

  /* Whole card clickable via stretched link */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  p {
    font-size: 0.98rem;
    color: var(--text-muted);
  }
</style>
