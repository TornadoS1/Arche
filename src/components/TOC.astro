---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  // A section rendered outside the Markdown (e.g. the FAQ), listed before the sources
  extra?: { slug: string; text: string };
}

const { headings, extra } = Astro.props;

// Pages with several h2 sections list those; single-section pages list their h3 steps.
const h2 = headings.filter((h) => h.depth === 2);
let items: { slug: string; text: string }[] = h2.length >= 2 ? h2 : headings.filter((h) => h.depth === 3);
if (extra) {
  const sources = items.findIndex((h) => h.slug === 'footnote-label');
  items = sources >= 0 ? [...items.slice(0, sources), extra, ...items.slice(sources)] : [...items, extra];
}
---

{
  items.length >= 2 && (
    <nav class="toc" aria-labelledby="toc-title">
      <p id="toc-title" class="toc-title">Inhalt</p>
      <ul>
        {items.map((h) => (
          <li>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  // Highlight the section currently being read: the last listed heading above the top quarter of the viewport
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const targets = links
    .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
    .filter((el): el is HTMLElement => el !== null);

  let ticking = false;
  const update = () => {
    ticking = false;
    const line = window.innerHeight / 4;
    let active = -1;
    targets.forEach((el, i) => {
      if (el.getBoundingClientRect().top <= line) active = i;
    });
    links.forEach((a, i) => (i === active ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
  };

  if (targets.length === links.length && links.length > 0) {
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>

<style>
  .toc {
    font-family: var(--font-ui);
    font-size: 0.92rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.2rem 0.6rem;
  }

  .toc-title {
    margin: 0 0 0.5rem;
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    margin-bottom: 0.4rem;
    line-height: 1.4;
  }

  a {
    display: block;
    margin-left: -0.6rem;
    padding-left: calc(0.6rem - 3px);
    border-left: 3px solid transparent;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  a[aria-current='true'] {
    border-left-color: var(--accent);
    font-weight: 600;
  }
</style>
