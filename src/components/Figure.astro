---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  creditUrl?: string;
  priority?: boolean;
}

const { src, alt, caption, credit, creditUrl, priority = false } = Astro.props;
---

<figure>
  <Image
    src={src}
    alt={alt}
    widths={[480, 800, 1200, Math.min(src.width, 1600)]}
    sizes="(max-width: 72rem) 100vw, 72rem"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
  {
    (caption || credit) && (
      <figcaption>
        {caption && <span>{caption}</span>}
        {credit && (
          <span class="credit">
            Bild: {creditUrl ? <a href={creditUrl}>{credit}</a> : credit}
          </span>
        )}
      </figcaption>
    )
  }
</figure>

<style>
  figure {
    margin: 2rem 0;
  }

  figure :global(img) {
    width: 100%;
    border-radius: var(--radius);
    background: var(--surface-2);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.2rem 1rem;
    margin-top: 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .credit {
    font-size: 0.8rem;
  }
</style>
