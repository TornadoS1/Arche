---
// Map: great-circle distance from Mount Ararat to eastern Australia (Brisbane).
// Coastlines from Natural Earth (public domain), simplified by scripts/build_map_paths.py.
import map from '../data/koala-map.json';

const [west, , , north] = map.bbox;
const p = (lon: number, lat: number) => [(lon - west) * map.scale, (north - lat) * map.scale] as const;

const ararat = { lon: 44.3, lat: 39.7 };
const brisbane = { lon: 153.03, lat: -27.47 };

// Great circle: spherical linear interpolation between the two points
const rad = Math.PI / 180;
const toVec = ({ lon, lat }: { lon: number; lat: number }) => [
  Math.cos(lat * rad) * Math.cos(lon * rad),
  Math.cos(lat * rad) * Math.sin(lon * rad),
  Math.sin(lat * rad),
];
const a = toVec(ararat);
const b = toVec(brisbane);
const omega = Math.acos(a[0] * b[0] + a[1] * b[1] + a[2] * b[2]);
const distanceKm = Math.round((omega * 6371) / 100) * 100;
const steps = 48;
const route = Array.from({ length: steps + 1 }, (_, i) => {
  const t = i / steps;
  const s1 = Math.sin((1 - t) * omega) / Math.sin(omega);
  const s2 = Math.sin(t * omega) / Math.sin(omega);
  const v = [0, 1, 2].map((k) => s1 * a[k] + s2 * b[k]);
  const lat = Math.atan2(v[2], Math.hypot(v[0], v[1])) / rad;
  const lon = Math.atan2(v[1], v[0]) / rad;
  return p(lon, lat);
});
const routePath = 'M' + route.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join('L');

const [ax, ay] = p(ararat.lon, ararat.lat);
const [bx, by] = p(brisbane.lon, brisbane.lat);
const [mx, my] = route[Math.round(steps * 0.55)];
const fmtKm = distanceKm.toLocaleString('de-DE');
---

<figure class="koala-map">
  <svg viewBox={`0 0 ${map.width} ${map.height}`} role="img" aria-labelledby="km-title km-desc">
    <title id="km-title">Karte: Luftlinie vom Berg Ararat nach Ostaustralien</title>
    <desc id="km-desc">
      Weltkartenausschnitt von Afrika bis Australien. Eine Linie verbindet den Berg Ararat in der Osttürkei mit
      Brisbane in Ostaustralien; die Luftlinie ist rund {fmtKm} Kilometer lang. Der Weg führt über Asien und die
      indonesischen Inseln, auf denen keine Koalas vorkommen.
    </desc>

    <rect width={map.width} height={map.height} class="sea"></rect>
    <path d={map.land} class="land" fill-rule="evenodd"></path>

    <path d={routePath} class="route"></path>
    <circle cx={ax} cy={ay} r="4" class="dot"></circle>
    <circle cx={bx} cy={by} r="4" class="dot"></circle>

    <text x={ax + 7} y={ay - 6} class="label strong halo">Ararat</text>
    <text x={bx - 7} y={by + 18} class="label strong halo" text-anchor="end">Ostaustralien</text>
    <text x={mx + 10} y={my} class="label strong halo">rund {fmtKm} km</text>
    <text x={mx + 10} y={my + 13} class="label halo">Luftlinie</text>
  </svg>
  <figcaption>
    Koalas leben nur in Australien. Der Landweg über Asien und die Inseln Indonesiens wäre noch deutlich länger als die
    Luftlinie. Küsten:
    <a href="https://www.naturalearthdata.com/">Natural Earth</a> (gemeinfrei), vereinfacht; Entfernung als
    Großkreis berechnet.
  </figcaption>
</figure>

<style>
  .koala-map {
    --km-sea: #d4e8f3;
    --km-land: #ebe5d6;
    --km-coast: #b8ad94;
    --km-route: #c2410c;

    margin: 2rem 0;
    padding: 0.8rem 0.8rem 0.7rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-family: var(--font-ui);
  }

  @media (prefers-color-scheme: dark) {
    .koala-map {
      --km-sea: #1d3a50;
      --km-land: #4a4740;
      --km-coast: #6e695e;
      --km-route: #fb923c;
    }
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .sea {
    fill: var(--km-sea);
  }

  .land {
    fill: var(--km-land);
    stroke: var(--km-coast);
    stroke-width: 0.4;
  }

  .route {
    fill: none;
    stroke: var(--km-route);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 6 4;
  }

  .dot {
    fill: var(--km-route);
    stroke: var(--surface);
    stroke-width: 2;
  }

  .label {
    font-size: 12px;
    fill: var(--text);
  }

  .label.strong {
    font-weight: 700;
  }

  .halo {
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-muted);
  }
</style>
