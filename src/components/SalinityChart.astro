---
// Horizontal bar chart: salinity of today's ocean vs. a fully mixed flood ocean.
// Plain HTML/CSS bars (responsive, theme-aware); ranges are drawn as a solid bar
// up to the lower bound plus a light wash up to the upper bound.

interface Row {
  label: string;
  min: number; // g/kg
  max: number; // g/kg
  value: string; // display text at the bar tip
  note: string;
  highlight?: boolean;
}

const rows: Row[] = [
  { label: 'Meerwasser heute (Mittel)', min: 35, max: 35, value: '35', note: 'NOAA' },
  {
    label: 'Flutwasser über dem Everest, vollständig durchmischt',
    min: 8,
    max: 10,
    value: '8–10',
    note: 'eigene Rechnung',
    highlight: true,
  },
  { label: 'Oberfläche der zentralen Ostsee', min: 6, max: 8, value: '6–8', note: 'IOW' },
  { label: 'Süßwasser', min: 1, max: 1, value: '< 1', note: 'USGS' },
];

const scaleMax = 40;
const ticks = [0, 10, 20, 30, 40];
const pct = (v: number) => `${(v / scaleMax) * 100}%`;
---

<figure class="salinity" aria-labelledby="salinity-title">
  <p id="salinity-title" class="chart-title">Salzgehalt in Gramm pro Kilogramm Wasser</p>

  <div class="plot" aria-hidden="true">
    <div class="grid">
      {ticks.map((t) => <span class="gridline" style={`left: ${pct(t)}`} />)}
    </div>
    {
      rows.map((r) => (
        <div class:list={['row', { highlight: r.highlight }]}>
          <span class="label">{r.label}</span>
          <div class="track" title={`${r.label}: ${r.value} g/kg (${r.note})`}>
            <span class="bar" style={`width: ${pct(r.min)}`} />
            {r.max > r.min && <span class="range" style={`left: ${pct(r.min)}; width: ${pct(r.max - r.min)}`} />}
            <span class="value" style={`left: ${pct(r.max)}`}>
              {r.value}
            </span>
          </div>
        </div>
      ))
    }
    <div class="axis">
      {
        ticks.map((t) => (
          <span class="tick" style={`left: ${pct(t)}`}>
            {t}
          </span>
        ))
      }
    </div>
  </div>

  <details class="table-view">
    <summary>Werte als Tabelle</summary>
    <table>
      <thead>
        <tr><th scope="col">Wasser</th><th scope="col">Salzgehalt (g/kg)</th><th scope="col">Quelle</th></tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <th scope="row">{r.label}</th>
              <td>{r.value}</td>
              <td>{r.note}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>

  <figcaption>
    Würde die Salzmenge der heutigen Meere mit genug Wasser verdünnt, um den Mount Everest zu bedecken, entstünde
    Brackwasser: zu süß für Meeresfische, zu salzig für Süßwasserfische. Quellen und Rechenweg in den Fußnoten.
  </figcaption>
</figure>

<style>
  .salinity {
    margin: 2rem 0;
    padding: 1.1rem 1.2rem 0.9rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-family: var(--font-ui);
  }

  .chart-title {
    margin: 0 0 1rem;
    font-size: 0.95rem;
    font-weight: 650;
    color: var(--text);
  }

  .plot {
    position: relative;
    /* room on the right so the longest bar's value label never clips */
    margin-right: 2.2rem;
  }

  .grid {
    position: absolute;
    inset: 0 0 1.4rem 0;
    pointer-events: none;
  }

  .gridline {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--chart-grid);
  }

  .row {
    position: relative;
    padding: 0.15rem 0 0.7rem;
  }

  .label {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.85rem;
    line-height: 1.3;
    color: var(--text-muted);
  }

  .row.highlight .label {
    color: var(--text);
    font-weight: 600;
  }

  .track {
    position: relative;
    height: 20px;
  }

  .bar,
  .range {
    position: absolute;
    top: 0;
    height: 20px;
    background: var(--chart-1);
  }

  .bar {
    left: 0;
    border-radius: 0 4px 4px 0;
  }

  .range {
    opacity: 0.35;
    border-radius: 0 4px 4px 0;
    /* 2px surface gap between solid bar and range wash */
    border-left: 2px solid var(--surface);
  }

  .value {
    position: absolute;
    top: 0;
    line-height: 20px;
    padding-left: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text);
    white-space: nowrap;
  }

  .axis {
    position: relative;
    height: 1.4rem;
    border-top: 1px solid var(--border);
  }

  .tick {
    position: absolute;
    top: 0.2rem;
    transform: translateX(-50%);
    font-size: 0.75rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .table-view {
    margin-top: 0.8rem;
    font-size: 0.85rem;
  }

  .table-view summary {
    cursor: pointer;
    color: var(--accent);
  }

  table {
    width: 100%;
    margin-top: 0.6rem;
    border-collapse: collapse;
  }

  th,
  td {
    padding: 0.35rem 0.4rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
    font-weight: 400;
  }

  thead th {
    font-weight: 650;
  }

  td:nth-child(2) {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  figcaption {
    margin-top: 0.8rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
